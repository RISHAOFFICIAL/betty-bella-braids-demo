    <div class="booking-cta-actions">
      <a href="tel:+12247953104" class="btn btn-light">Call (224) 795-3104</a>
      <a href="https://www.instagram.com/betty_bella_braids/" class="btn btn-ghost" target="_blank" rel="noopener">Instagram</a>
    </div>
