      <span>Demo site built by <a href="https://rishaofficial.github.io/lexis-sapphire-studio/" target="_blank" rel="noopener">Lexis Sapphire Studio</a></span>
    </div>
  </div>
</footer>

<script>
  function showCategory(catId, btn) {
    // Hide all groups
    document.querySelectorAll('.service-group').forEach(g => g.classList.remove('active'));
    // Remove active from all buttons
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    // Show selected group
    document.getElementById('cat-' + catId).classList.add('active');
    // Mark button active
    btn.classList.add('active');
  }

  function toggleMobileNav() {
    document.getElementById('mobileNav').classList.toggle('open');
  }

  // Falling autumn leaves
  (function() {
    const leaves = ['\uD83C\uDF42', '\uD83C\uDF41', '\uD83C\uDF43'];
    const isMobile = window.innerWidth < 768;
    const count = isMobile ? 8 : 14;

    for (let i = 0; i < count; i++) {
      const leaf = document.createElement('span');
      leaf.className = 'falling-leaf';
      leaf.textContent = leaves[Math.floor(Math.random() * leaves.length)];
      leaf.style.left = Math.random() * 100 + 'vw';
      leaf.style.fontSize = (16 + Math.random() * 12) + 'px';
      leaf.style.animationDuration = (isMobile ? 12 : 8) + (Math.random() * 8) + 's';
      leaf.style.animationDelay = (-Math.random() * 12) + 's';
      document.body.appendChild(leaf);
    }
  })();
</script>

</body>
</html>
