          <a href="tel:+12247953104">(224) 795-3104</a>
          <a href="https://maps.google.com/?q=1601+Portage+St,+Kalamazoo,+MI+49001" target="_blank" rel="noopener">1601 Portage St, Kalamazoo, MI 49001</a>
        </div>
