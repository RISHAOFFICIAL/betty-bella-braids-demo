        <li class="service-card"><a class="service-card-link" href="tel:+12247953104"><span class="service-photo g1" aria-hidden="true">B</span><span class="service-details"><span class="service-name">Human Hair Knotless Boho Braids</span><span class="service-time">6 hrs</span><span class="service-card-foot"><span class="service-price">$320</span><span class="service-book-btn">Book</span></span></span></a></li>
        <li class="service-card"><a class="service-card-link" href="tel:+12247953104"><span class="service-photo g3" aria-hidden="true">B</span><span class="service-details"><span class="service-name">Boho Box Braids</span><span class="service-time">6 hrs</span><span class="service-card-foot"><span class="service-price">$260</span><span class="service-book-btn">Book</span></span></span></a></li>
