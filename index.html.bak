      <ul class="service-list">
        <li class="service-card"><a class="service-card-link" href="tel:+12247953104"><span class="service-photo g4" aria-hidden="true">B</span><span class="service-details"><span class="service-name">Box Braids (Medium)</span><span class="service-time">5 hrs</span><span class="service-card-foot"><span class="service-price">$220</span><span class="service-book-btn">Book</span></span></span></a></li>
        <li class="service-card"><a class="service-card-link" href="tel:+12247953104"><span class="service-photo g1" aria-hidden="true">S</span><span class="service-details"><span class="service-name">Stitch Braids</span><span class="service-time">3 hrs</span><span class="service-card-foot"><span class="service-price">$150</span><span class="service-book-btn">Book</span></span></span></a></li>
